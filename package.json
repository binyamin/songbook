{
	"name": "songbook",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:prod": "drizzle-kit migrate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"devDependencies": {
		"@evilmartians/harmony": "^1.4.0",
		"@kochav/css": "gitlab:binyamin/kochav-css#semver:^0.2.0",
		"@libsql/client": "^0.18.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"drizzle-valibot": "^0.4.2",
		"nanoid": "^6.0.2",
		"postcss-jit-props": "^1.0.16",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"valibot": "^1.5.0",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"svelte": "5.x"
	},
	"packageManager": "pnpm@12.15.0"
}
