---
import '~/css/style.css';
import './base.css';

import { Show } from 'solid-js';

import { Button } from '~/components/elements/button';
import { site } from '~/const';

export interface Props {
	title: string | false;
}

const docTitle = (Astro.props.title ? Astro.props.title + ' | ' : '')
	+ site.title;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{docTitle}</title>
	</head>
	<body>
		<div id="root" class="l-gelati | flow">
			<nav class="site-header | l-repel">
				<a href="/" class="logo" aria-label="Home">{site.title}</a>
				<ul role="list" class="l-cluster">
					<li><a href="/songs">Songs</a></li>
					<Show when={Astro.locals.isAdmin}>
						<li>
							<form method="POST" action="/admin/logout" name="logout">
								<Button type="submit" color="danger" variant="soft"
								>Log out</Button>
							</form>
						</li>
					</Show>
				</ul>
			</nav>
			<Show when={Astro.locals.isAdmin}>
				<script>
					const form = document.forms.namedItem('logout');

					if (form) {
						form.addEventListener('submit', (ev) => {
							ev.preventDefault();

							const res = window.confirm('Are you sure you want to log out?');

							if (res) {
								form.submit();
							}
						});
					}
				</script>
			</Show>
			<main>
				<slot />
			</main>
			<footer class="l-center">
				<p>
					<span>Made with love by Binyamin Green</span> |{' '}
					<a href="/admin">Admin</a>
				</p>
			</footer>
		</div>
	</body>
</html>
