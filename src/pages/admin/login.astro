---
export const prerender = false;

import Layout from '~/layouts/base.astro';

import { Button } from '~/components/elements/button';
import '~/components/elements/form-field/text-field.css';

import { verify } from '~/services/auth.ts';
import { cookieOptions, createToken } from '~/services/server/session';

let error = '';

if (Astro.request.method === 'POST') {
	const pw = String((await Astro.request.formData()).get('password') ?? '');

	const isAdmin = verify(pw);

	if (isAdmin) {
		Astro.cookies.set('session', createToken(), cookieOptions);
		return Astro.redirect('/admin', 303);
	}

	error = 'Incorrect username or password';
}
---

<Layout title="Log in">
	<article class="prose | flow">
		<h1>Log in</h1>

		<form method="post" class="flow">
			<div class="form-field">
				<label for="form-password">Password</label>
				<input
					class="input"
					data-type="text"
					type="password"
					name="password"
					id="form-password"
					required
					autocomplete="current-password"
					minlength="8"
				/>
			</div>

			{error && <p class="_error" role="alert">{error}</p>}

			<Button type="submit">Log in</Button>
		</form>
	</article>
</Layout>
